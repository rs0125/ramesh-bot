# Worker configuration; load from the repository root.
# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Enables the two-node LangGraph conversational reply flow when set.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
AGENT_TIMEOUT_MS="45000"
AGENT_MAX_OUTPUT_TOKENS="800"
# npm run dev:chat always uses isolated SQLite and never connects to WhatsApp or Supabase.
PLAYGROUND_PORT="3012"
# Optional Supabase message state + durable queue. Use the restricted provisioned login.
# WhatsApp auth, admin sessions and operator settings remain in the SQLite database above.
MESSAGE_DATABASE_URL=""
MESSAGE_DB_SSL_CA=""
MESSAGE_ACCOUNT_ID="primary"
MESSAGE_QUEUE_POLL_MS="5000"
# Encrypts linked-device credentials and keys in SQLite; back up separately from the DB.
AUTH_ENCRYPTION_KEY=""
LOG_LEVEL="info"
WORKER_HOST="127.0.0.1"
WORKER_PORT="3011"
# setup:local generates this secret; configure the same token in the separate admin app.
WORKER_API_TOKEN=""
WHATSAPP_AUTO_CONNECT="false"
MAX_MESSAGE_AGE_SECONDS="300"
SHUTDOWN_TIMEOUT_MS="10000"
MAX_PENDING_MESSAGES="100"
SEND_TIMEOUT_MS="15000"
# Randomized pacing per eligible reply; milliseconds, not a guarantee against restrictions.
REPLY_DELAY_MIN_MS="1500"
REPLY_DELAY_MAX_MS="4000"
# QR codes stay in the authenticated UI unless terminal rendering is explicitly enabled.
PRINT_QR="false"
