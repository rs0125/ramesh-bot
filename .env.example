# Worker configuration; load from the repository root.
# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Enables the two-node LangGraph conversational reply flow when set.
OPENAI_API_KEY=""
# Optional public web tools for employee DMs; blank disables web_search/read_webpage.
# calculate is local and does not need this key. Free-tier billing is managed in Tavily.
TAVILY_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
# Luna routes/formats/extracts; OPENAI_MODEL plans, uses tools and verifies. single restores the old path.
AGENT_MODEL_ROUTING="split"
AGENT_TOOL_REASONING_EFFORT="medium"
# Eager is the compatibility default; deferred requires native OpenAI tool search.
AGENT_TOOL_LOADING="eager"
AGENT_TIMEOUT_MS="45000"
AGENT_MAX_OUTPUT_TOKENS="800"
# Opt in only after applying 202610050001_conversation_context.sql. Verified DMs only.
# Long context runs should use AGENT_TIMEOUT_MS=240000 and AGENT_MAX_OUTPUT_TOKENS=6000.
AGENT_CONTEXT_ENABLED="false"
AGENT_CONTEXT_MAX_INPUT_TOKENS="96000"
AGENT_CONTEXT_COMPACT_THRESHOLD="64000"
# Runtime currency accounting is opt-in. No default rates or spend allowance.
# Production observe/enforce requires the restricted Supabase runtime and migration 202610020006.
# Capture uses its separate login/tables and migration 202610020003.
# See docs/agent-modules/43-usage-ledger-and-budgets.md before enabling.
USAGE_MODE="off"
# USAGE_PRICES_JSON: reviewed versioned JSON with exact model rates and safe token ceilings.
# Optional USD caps: USAGE_RUN_MAX_USD, USAGE_SUBJECT_DAY_MAX_USD, USAGE_ACCOUNT_DAY_MAX_USD.
# Omit unused caps; do not set blank values. Enforce requires pricing and at least one cap.
# Daily buckets use UTC. New caps do not reconstruct previously untracked spending.
# Paid evals separately require EVAL_MAX_USD (or --max-usd) and EVAL_USAGE_PRICES_JSON.
# Set only the allowance actually approved; Sol agent/grader tests still need explicit approval.
# Multi-deal sales loops may need AGENT_TIMEOUT_MS=240000 and AGENT_MAX_OUTPUT_TOKENS=6000.
# npm run dev:chat always uses isolated SQLite and never connects to WhatsApp or Supabase.
# Real-data GUI: npm run dev:chat:live loads a SEPARATE .local/live-playground.env.
# Provision with npm run db:playground; see docs/live-data-playground.md.
# That file owns PLAYGROUND_DATABASE_URL, PLAYGROUND_DB_SSL_CA, PLAYGROUND_NAMESPACE,
# PLAYGROUND_EMPLOYEE_ID, PLAYGROUND_EMPLOYEE_LABEL, PLAYGROUND_ENCRYPTION_KEY and model/signing settings.
# No production database fallback or switch to enable real delivery exists in the live GUI.
PLAYGROUND_PORT="3012"
# Scoped MCP services; the business-read pilot remains off unless explicitly enabled below.
# Preferred endpoint: https://<context-origin>/mcp/ramesh; independently authorized per employee.
CONTEXT_MCP_URL=""
# Private Ed25519 service key JSON; see docs/signed-context-auth.md. Never commit a real key.
CONTEXT_RAMESH_SIGNING_KEY_JSON=""
CONTEXT_MCP_TIMEOUT_MS="30000"
CONTEXT_MCP_MAX_RESPONSE_BYTES="1048576"
# General employee-scoped read tools. Requires migration 202610010004, Supabase and signed MCP.
BUSINESS_READS_ENABLED="false"
# Requires the write journal migration and explicit current Context Engine write scopes.
BUSINESS_WRITES_ENABLED="false"
BUSINESS_READ_EMPLOYEE_IDS="all"
# Optional model-free operator probe; these checks do not grant access or send messages.
# Choose an active employee explicitly with CAPABILITY_PROBE_EMPLOYEE_ID before running.
# CAPABILITY_PROBE_REQUIRED="crm,warehouses"
# CAPABILITY_PROBE_OPTIONAL="knowledge,ga4,search_console"
# CAPABILITY_PROBE_TIMEOUT_MS="45000"
# See docs/agent-modules/44-capability-readiness.md for private env-file usage.
# Optional legacy OAuth adapter only: exact HTTPS callback URI allowlisted by Context Engine.
# Local HTTP callbacks require a local HTTP Context Engine. No callback listener is added to the worker.
CONTEXT_OAUTH_REDIRECT_URI=""
# Optional Supabase message state + durable queue. Use the restricted provisioned login.
# WhatsApp auth, admin sessions and operator settings remain in the SQLite database above.
MESSAGE_DATABASE_URL=""
MESSAGE_DB_SSL_CA=""
MESSAGE_ACCOUNT_ID="primary"
MESSAGE_QUEUE_POLL_MS="5000"
# Simultaneous conversations; each conversation and outbound delivery remain ordered.
MESSAGE_QUEUE_CONCURRENCY="3"
# Encrypts linked-device credentials and keys in SQLite; back up separately from the DB.
AUTH_ENCRYPTION_KEY=""
LOG_LEVEL="info"
WORKER_HOST="127.0.0.1"
WORKER_PORT="3011"
# setup:local generates this secret; configure the same token in the separate admin app.
WORKER_API_TOKEN=""
# Optional separate credential for CRM/server outbound sends; 32 random bytes in base64url.
# Requires MESSAGE_DATABASE_URL. Keep empty to disable the automation API.
RAMESH_AUTOMATION_API_KEY=""
# Personal task/reminder tools for active verified employees in DMs.
PERSONAL_SCHEDULING_ENABLED=false
# Separate switch to pause due admission while retaining schedules and tools.
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_POLL_MS=30000
WHATSAPP_AUTO_CONNECT="false"
MAX_MESSAGE_AGE_SECONDS="300"
SHUTDOWN_TIMEOUT_MS="10000"
MAX_PENDING_MESSAGES="100"
SEND_TIMEOUT_MS="15000"
# Prepared replies have no artificial delay. Explicit nonzero bounds enable optional pacing.
REPLY_DELAY_MIN_MS="0"
REPLY_DELAY_MAX_MS="0"
# QR codes stay in the authenticated UI unless terminal rendering is explicitly enabled.
PRINT_QR="false"

# Coalesce message bursts before the agent runs. Forwarded messages and media use the longer window.
INBOUND_TEXT_QUIET_MS=1000
INBOUND_BURST_QUIET_MS=3000
INBOUND_MAX_WAIT_MS=8000
# Private media copies and extracts expire after 24 hours; original audio is sent directly to STT.

# Optional separate OpenAI credential for voice-note / forwarded-audio STT.
# Blank falls back to OPENAI_API_KEY. Never commit a real key here.
OPENAI_STT_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
