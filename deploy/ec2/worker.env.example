# Install as /etc/wareongo-sales-bot/worker.env, owned by root with mode 0600.
# systemd injects these settings; state stays outside the source checkout.
DATABASE_URL="file:/var/lib/wareongo-sales-bot/bot.db"
# A separate 32-byte base64url key; back it up separately from the encrypted database.
AUTH_ENCRYPTION_KEY=""
LOG_LEVEL="info"
# Only Caddy on the same instance may reach this HTTP listener directly.
WORKER_HOST="127.0.0.1"
WORKER_PORT="3011"
# Set a fresh random secret of at least 32 characters, also configured on Vercel.
WORKER_API_TOKEN=""
# Separate outbound automation credential; blank disables the API.
RAMESH_AUTOMATION_API_KEY=""
PERSONAL_SCHEDULING_ENABLED=false
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_POLL_MS=30000
# Reconnect after service/instance restarts. First pairing still needs a QR scan.
WHATSAPP_AUTO_CONNECT="true"
# Provision Supabase separately, then copy its restricted runtime connection here.
# Empty means the original SQLite greeting mode; never use the Supabase admin login.
MESSAGE_DATABASE_URL=""
MESSAGE_DB_SSL_CA=""
MESSAGE_ACCOUNT_ID="primary"
MESSAGE_QUEUE_POLL_MS="5000"
MESSAGE_QUEUE_CONCURRENCY="3"
MAX_MESSAGE_AGE_SECONDS="300"
SHUTDOWN_TIMEOUT_MS="10000"
MAX_PENDING_MESSAGES="100"
SEND_TIMEOUT_MS="15000"
PRINT_QR="false"
## Optional conversational replies. Keep the API key in the server's private environment.
OPENAI_API_KEY=""
# Optional Tavily search + extraction for employee DMs. Blank keeps both tools hidden.
TAVILY_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
AGENT_TIMEOUT_MS="45000"
AGENT_MAX_OUTPUT_TOKENS="800"
# Metering defaults off; no production settings are changed by this example.
# Before enabling, apply production migration 202610020006 with the existing provisioning workflow.
# Use reviewed exact-model rates/ceilings in USAGE_PRICES_JSON and explicitly chosen USD caps.
USAGE_MODE="off"
# Optional caps: USAGE_RUN_MAX_USD, USAGE_SUBJECT_DAY_MAX_USD, USAGE_ACCOUNT_DAY_MAX_USD.
# Omit unused caps. Observe records only; enforce requires pricing and at least one cap.
# UTC daily buckets; unknown usage stays held. This is not provider invoice reconciliation.
# See docs/agent-modules/43-usage-ledger-and-budgets.md for activation and limitations.
# Paid evaluations use a separate explicit allowance and still require approval for Sol.
# Employee-scoped MCP reads remain disabled unless explicitly enabled in private configuration.
CONTEXT_MCP_URL=""
# Private Ed25519 service key JSON; see docs/signed-context-auth.md. Never commit a real key.
CONTEXT_RAMESH_SIGNING_KEY_JSON=""
CONTEXT_MCP_TIMEOUT_MS="30000"
CONTEXT_MCP_MAX_RESPONSE_BYTES="1048576"
# Optional operator readiness probe, separate from /healthz and not automatically run by CD.
# Set CAPABILITY_PROBE_EMPLOYEE_ID to an explicitly selected active employee before probing.
# CAPABILITY_PROBE_REQUIRED="crm,warehouses"
# CAPABILITY_PROBE_OPTIONAL="knowledge,ga4,search_console"
# CAPABILITY_PROBE_TIMEOUT_MS="45000"
# See docs/agent-modules/44-capability-readiness.md; never put employee data into this example.
# Optional legacy OAuth adapter only; allowlist its owned origin in Context Engine.
# The worker does not start an OAuth callback listener.
CONTEXT_OAUTH_REDIRECT_URI=""
