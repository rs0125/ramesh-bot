#!/bin/sh
# Root-owned fixed entry point. The SSM document accepts a SHA, never arbitrary shell commands.
set -eu
umask 077
exec /usr/bin/flock --nonblock /run/lock/wareongo-bot-deploy.lock /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/node --experimental-strip-types /usr/local/lib/wareongo-bot-deploy/ec2-release.ts "$@"
