{
  "name": "@wareongo/bot-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:chat": "tsx scripts/playground.ts",
    "dev:chat:live": "tsx scripts/playground-live.ts",
    "db:playground": "tsx scripts/setup-playground.ts",
    "smoke:chat:live": "tsx scripts/smoke-playground.ts",
    "eval:tool-loading": "tsx evals/tool-loading-run.ts",
    "eval:agent": "tsx evals/run.ts",
    "eval:business": "tsx evals/business-run.ts",
    "eval:sales": "tsx evals/sales-run.ts",
    "eval:conversations": "tsx evals/conversation-run.ts --suite conversation",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts deploy/tests/*.test.ts",
    "check": "npm run prisma:validate && npm run typecheck && npm test && npm run build && npm run format:check",
    "format": "prettier --write --ignore-unknown src tests scripts evals playground deploy .github *.json *.md docs",
    "format:check": "prettier --check --ignore-unknown src tests scripts evals playground deploy .github *.json *.md docs",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:messages": "tsx scripts/setup-message-database.ts",
    "db:identity": "tsx scripts/setup-identity-roster.ts",
    "context:auth": "tsx scripts/context-auth.ts",
    "capability:preflight": "tsx scripts/capability-preflight.ts",
    "catalogue:drift": "tsx scripts/catalogue-drift.ts",
    "probe:strict-catalogue": "tsx scripts/strict-catalogue-probe.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "eval:journeys": "tsx evals/conversation-run.ts --suite journeys",
    "eval:adversarial": "tsx evals/conversation-run.ts --suite adversarial",
    "eval:compare-models": "tsx evals/compare-models.ts",
    "eval:ci": "tsx evals/conversation-run.ts --suite all --output .local/ci-evals",
    "eval:private": "tsx evals/private-run.ts",
    "eval:judge": "tsx evals/judge-calibration-run.ts",
    "eval:regrade": "tsx evals/regrade-run.ts",
    "eval:stt": "tsx evals/stt-run.ts",
    "eval:scheduling": "tsx evals/scheduling-run.ts",
    "eval:context": "tsx evals/context-run.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.15.5",
    "@types/qrcode-terminal": "0.12.2",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "dependencies": {
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "@modelcontextprotocol/client": "2.2.0",
    "@prisma/client": "6.19.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "17.4.1",
    "jose": "6.2.12",
    "js-tiktoken": "1.0.21",
    "langsmith": "0.10.5",
    "openai": "7.25.0",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  }
}
